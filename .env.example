# LLM Provider Configuration
# Supported: OpenAI or OpenAI-compatible provider (e.g. Gemini, Groq, Ollama)
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible endpoints (e.g. Gemini OpenAI compatibility endpoint or OpenRouter)
OPENAI_BASE_URL=

# App URL (optional for local development, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistence Configuration
# Pairwise supports dual-mode persistence:
# 1. Local JSON/SQLite storage (zero config, works out of the box for development/demo)
# 2. Supabase / PostgreSQL (for production deployments)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
